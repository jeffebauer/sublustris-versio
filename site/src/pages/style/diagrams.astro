---
// The tiny diagrams, other pictures (stop 3, direction B): for each of the eight ideas,
// today's drawing as option 1 and two or three other metaphors in the same line style, on
// paper, on a tile and on a dark band, then all of them at the audio tile's size. Numbered
// per idea so the owner can answer "endless 3, freeze 2". Not in the sitemap, noindex.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import { CONCEPTS } from '../../components/diagrams/metaphors';
import '../../styles/directions/b.css';

const GROUNDS = [
  { id: 'paper', title: 'On paper', note: 'The page itself, at about bento size.', band: '', cell: '' },
  { id: 'tile', title: 'On a tile', note: 'Inside a tile, as in the bento and the audio tiles.', band: '', cell: 'tile' },
  { id: 'dark', title: 'On a dark band', note: 'The hero and the sound band: light ink, the brighter blue.', band: 'band-dark', cell: '' },
];
const risky = CONCEPTS.flatMap((c) => c.options.map((o, i) => ({ c, o, n: i + 1 })).filter((x) => x.o.risk));
---
<Base title="Diagram Metaphors" description="For each of the eight ideas the Sublustris Versio site draws, today's diagram and other pictures of it in the same line style, numbered for choosing." noindex bodyClass="dir-b" darkTop>
  <section class="st-section st-hero band-dark" aria-labelledby="dg-title">
    <div class="column">
      <p class="micro quiet st-kicker">Style tile B · tiny diagrams</p>
      <h1 class="display" id="dg-title">Other pictures of the same ideas</h1>
    </div>
    <div class="column flow st-intro">
      <p class="lede">The same line style throughout: the 160 × 64 grid, 1.5 px lines in the text colour, the blue on the reverb, faint guides. What changes is the picture. Option 1 is today’s drawing; the others are different ways to show the same sound.</p>
      <p class="quiet">Your picks (30 Oct) are marked “Picked”; the style tiles and demo cards use them.</p>
      <p class="demo-row">
        <Button href="/style/b/" variant="ghost">Style tile B</Button>
        <Button href="/style/" variant="ghost">All three directions</Button>
      </p>
    </div>
  </section>

  {GROUNDS.map((g) => (
    <section class:list={['st-section', g.band]} aria-labelledby={`dg-${g.id}`}>
      <div class="column"><h2 class="h2" id={`dg-${g.id}`}>{g.title}</h2><p class="quiet">{g.note}</p></div>
      <div class="wide dg-matrix">
        {CONCEPTS.map((c) => (
          <div class="dg-row">
            <p class="dg-name micro" style={`--rows: ${Math.ceil(c.options.length / 4)}`}>{c.name}</p>
            {c.options.map((o, i) => (
              <figure class:list={['dg-cell', g.cell, c.picked === i + 1 && 'is-picked']}>
                <Diagram kind={o.kind} />
                <figcaption class="dg-cap small"><span class="dg-n" aria-label={`${c.id} ${i + 1}`}>{i + 1}</span><span>{o.caption}{c.picked === i + 1 && <strong class="dg-picked"> · Picked</strong>}</span></figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="st-section" aria-labelledby="dg-real">
    <div class="column"><h2 class="h2" id="dg-real">At real size</h2><p class="quiet">Every option at the audio tile’s size (3.25 rem high), the smallest the diagrams get on the site.</p></div>
    <div class="wide dg-strip">
      {CONCEPTS.map((c) => (
        <div class="dg-strip-row">
          <p class="dg-name micro">{c.name}</p>
          <ul class="dg-strip-list">
            {c.options.map((o, i) => (
              <li class="tile dg-small">
                <span class="dg-n" aria-hidden="true">{i + 1}</span>
                <Diagram kind={o.kind} class="demo-diagram" />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {risky.length > 0 && (
    <section class="st-section" aria-labelledby="dg-risk">
      <div class="column flow">
        <h2 class="h2" id="dg-risk">Might misread</h2>
        <p class="quiet">Resilio retired pictograms that read as a magnifying glass, a ghost and a face. These are the ones to look at twice.</p>
        <ul class="dg-risks">
          {risky.map(({ c, o, n }) => <li><strong>{c.id} {n}</strong>, {o.caption.toLowerCase()}: {o.risk}</li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style is:global>
  .dg-matrix { display: grid; }
  .dg-row { display: grid; grid-template-columns: minmax(0, 9rem) repeat(4, minmax(0, 1fr)); gap: var(--gutter); align-items: start; padding-block: var(--stack-3); }
  .dg-row + .dg-row { border-top: var(--hair) solid var(--line); }
  .dg-name { color: var(--ink-2); padding-top: var(--stack-1); }
  .dg-row > .dg-name { grid-row: span var(--rows, 1); }
  .dg-cell { margin: 0; display: grid; gap: var(--stack-2); color: var(--ink); align-content: start; }
  .dg-cell.tile { padding: clamp(0.75rem, 0.5rem + 0.6vw, 1.25rem); }
  .dg-cell .diagram { width: 100%; height: auto; }
  .dg-cap { display: flex; gap: 0.5em; align-items: baseline; color: var(--ink-2); margin: 0; }
  .dg-n {
    flex: none; display: inline-grid; place-items: center; min-width: 1.6em; height: 1.6em; padding-inline: 0.3em;
    border: var(--hair) solid currentColor; border-radius: 999px; font-variant-numeric: tabular-nums;
    font-size: 0.8125rem; line-height: 1; color: var(--ink);
  }
  @media (max-width: 63.99rem) {
    .dg-row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--stack-3); }
    .dg-name { grid-column: 1 / -1; }
    .dg-row > .dg-name { grid-row: auto; }
  }

  .dg-strip { display: grid; gap: var(--stack-4); }
  .dg-strip-list { list-style: none; padding: 0; margin: var(--stack-1) 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: var(--stack-2); }
  .dg-small { display: flex; gap: 0.75rem; align-items: center; padding: 0.75rem 1rem; }
  .dg-small .demo-diagram { flex: 1; min-width: 0; }

  .dg-picked { color: var(--sv-accent, var(--signal-text)); font-weight: 600; }
  .is-picked .dg-n { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .dg-risks { padding-left: 1.2em; display: grid; gap: var(--stack-1); }
</style>
