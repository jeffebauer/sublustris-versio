---
// The style tile's index (stop 3): the three directions for the owner to choose from, each
// shown in its own colours. Not in the sitemap, noindex.
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import '../../styles/directions/a.css';
import '../../styles/directions/b.css';
import '../../styles/directions/c.css';
import { DIRECTIONS, tokensFor, type DirectionId } from '../../lib/directions';

const ids: DirectionId[] = ['a', 'b', 'c'];
const SWATCHES = ['paper', 'tile', 'ink', 'ink-2', 'dark', 'signal', 'signal-ink'];
const cards = ids.map((id) => {
  const t = tokensFor(id).light;
  const extra = id === 'c' ? ['slate', 'signal-on-dark'] : [];
  return { id, dir: DIRECTIONS[id], chips: [...SWATCHES, ...extra].filter((k) => t[k]).map((k) => ({ k, hex: t[k] })) };
});
---
<Base title="Style tiles: Sublustris Versio" description="Three design directions for the Sublustris Versio site: dark with a faint glow, white with freeze blue, and night-blue bands." noindex bodyClass="dir-b">
  <section class="st-section st-index" aria-labelledby="st-index-title">
    <div class="column flow">
      <p class="micro quiet">Style tile · stop 3</p>
      <h1 class="display" id="st-index-title">Three directions</h1>
      <p class="lede">Sublustris is “dimly lit, faintly glowing”: the half-light of a clouded night. Three ways to say it, all sisters of Resilio Versio’s site. Each page shows the same parts in its own colours.</p>
    </div>
    <ul class="wide st-cards">
      {cards.map(({ id, dir, chips }) => (
        <li class={`dir-${id} st-card`}>
          <a href={`/style/${id}/`} class="st-card-link">
            <span class="st-card-band">
              <span class="micro">Direction {id.toUpperCase()}</span>
              <span class="h3">{dir.name}</span>
              <Diagram kind="endless" class="st-card-diagram" decorative />
            </span>
            <span class="st-card-body">
              <span class="small">{dir.summary}</span>
              <span class="st-card-chips" aria-hidden="true">{chips.map((c) => <span style={`background:${c.hex}`} title={`--${c.k} ${c.hex}`}></span>)}</span>
              <span class="micro quiet">{dir.hasDark ? 'Light and dark' : 'Dark only'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="wide st-index-more small"><a href="/style/diagrams/">The tiny diagrams, four ways</a>: today’s line set and three alternatives, side by side.</p>
  </section>
</Base>

<style is:global>
  .st-index { padding-top: calc(var(--header-h) + var(--stack-5)); }
  .st-cards { list-style: none; padding: 0; margin-top: var(--stack-5); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  @media (max-width: 63.99rem) { .st-cards { grid-template-columns: minmax(0, 1fr); } }
  .st-card { border-radius: var(--radius-tile); overflow: hidden; background: var(--paper); color: var(--ink); box-shadow: inset 0 0 0 var(--hair) var(--line); }
  .st-card-link { display: grid; height: 100%; text-decoration: none; color: inherit; border-radius: inherit; }
  .st-card-band { display: grid; gap: var(--stack-1); padding: var(--stack-3); background: var(--dark); color: var(--on-dark); --signal: var(--signal-on-dark); }
  .dir-a .st-card-band { background: var(--paper); }
  .st-card-diagram { width: 100%; max-width: 16rem; height: 4rem; margin-top: var(--stack-2); color: var(--on-dark); }
  .st-card-body { display: grid; gap: var(--stack-2); padding: var(--stack-3); align-content: start; }
  .st-card-body .small { color: var(--ink-2); }
  .st-card-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .st-card-chips span { width: 1.5rem; height: 1.5rem; border-radius: 50%; box-shadow: 0 0 0 1px rgb(127 127 127 / 0.35); }
  .st-index-more { margin-top: var(--stack-4); }
  .st-card-link:hover .h3 { text-decoration: underline; text-decoration-thickness: var(--hair); text-underline-offset: 0.15em; }
</style>
