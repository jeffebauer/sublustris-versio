---
// Hero study (owner, 30 Oct 2026: "a bit bland"): versions of the home hero, each a full
// screen, for the owner to compare and pick. A is the hero as it is; B sets a huge SUBLUSTRIS
// behind the module (the film is transparent); C lights the title from the module's side, as
// the name says, breathing with the LEDs; D combines B and C (the owner's pick, round 1).
// Round 2: E is D with the name in glass (it blurs and brightens the haze behind it, its edges
// catch specular light from the module's side, brightest at the centre); the name's meaning
// sits at the top of D and E; six candidate ledes replace the spec tags, switchable in place.
// The film here is the hold loop only (no reveal). Not in the sitemap, noindex.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Haze from '../../components/Haze.astro';
import { MINISITE } from '../../lib/paths';

const logo = await readFile(join(MINISITE, 'assets', 'logo', 'sublustris-logo.svg'), 'utf8');
const mark = `url("data:image/svg+xml;base64,${Buffer.from(logo).toString('base64')}")`;
// The logo's paths, for E's lit glass (the filter needs the shapes inline)
const paths = logo.replace(/^[\s\S]*?<g[^>]*>/, '').replace(/<\/g>[\s\S]*$/, '');
const now = 'A huge, warm, lush reverb for the Noise Engineering Versio. Also as an AU/VST3 plugin for macOS.';
// Round 2 ledes, from the most poetic (1) to an even balance of evocative and informative (6).
// 1-5 leave the platform to a quieter line under them.
const ledes = [
  'Light that lingers after the room goes dark. Tails that drift for minutes, then never fade, and a chord you can freeze and keep.',
  'A half-lit space that never quite ends. Hold a chord forever, play over it, and let it wear like old tape.',
  'Somewhere to stay inside a sound: slow swells, vast halls, an octave of shimmer, and tails that hold for as long as you like.',
  'Huge, warm and slow to fade. A plate, a hall and a massive wash, an endless hold, and a freeze you can play over.',
  'A huge, warm reverb with tails from a room to minutes, then endless. Freeze a chord and play over it; add shimmer, swells or tape-style wear.',
  'A huge, warm, lush reverb for the Noise Engineering Versio: three spaces, tails that run to endless, a freeze you play over, shimmer and tape-style wear. Also as an AU/VST3 plugin for macOS.',
];
const platform = 'For the Noise Engineering Versio, and as an AU/VST3 plugin for macOS.';
const versions = [
  { id: 'a', name: 'A · Now', note: 'The hero as it is.' },
  { id: 'b', name: 'B · The name behind', note: 'SUBLUSTRIS across the hero in the panel’s lettering; the module stands in front of it.' },
  { id: 'c', name: 'C · Half-lit', note: 'The title lit from the module’s side, fading into shadow, breathing with the freeze LEDs.' },
  { id: 'd', name: 'D · Both', note: 'Your pick: B’s name behind, lit like C. The name’s meaning now at the top.' },
  { id: 'e', name: 'E · Glass', note: 'D with the name in glass: the haze shows through it, softened; its edges catch the light from the module, brightest at the centre.' },
];
const behind = (id: string) => id === 'b' || id === 'd' || id === 'e';
const top = (id: string) => id === 'd' || id === 'e';
---
<Base title="Hero study: Sublustris Versio" description="Versions of the home hero to compare, with six candidate ledes." noindex bodyClass="home" darkTop>
  {versions.map((v) => (
    <section class={`hero band-dark has-haze hs hs-${v.id}`} style={`--mark: ${mark}`} aria-label={v.name}>
      <Haze strength={0.96} />
      <p class="hs-tag micro"><strong>{v.name}</strong> <span class="hs-note">{v.note}</span></p>
      {top(v.id) && <p class="hs-kicker hs-kicker-top mono"><em>sublustris</em>, Lat. · dimly lit, faintly glowing</p>}
      <div class="wide">
        {(v.id === 'b' || v.id === 'd') && <div class="hs-mark" aria-hidden="true"><span class="hs-mark-base"></span><span class="hs-mark-lit"></span></div>}
        {v.id === 'e' && (
          <div class="hs-mark hs-glass" aria-hidden="true">
            <span class="hs-glass-body"></span>
            <svg class="hs-glass-light" viewBox="0 0 444 40" preserveAspectRatio="xMidYMid meet">
              <defs>
                <filter id="hs-glass" x="-4%" y="-40%" width="108%" height="180%" color-interpolation-filters="sRGB">
                  <!-- the letters' bevel: a soft height map from their shape -->
                  <feGaussianBlur in="SourceAlpha" stdDeviation="1.3" result="bump" />
                  <!-- a point light above the module (the centre): the hot glints -->
                  <feSpecularLighting in="bump" surfaceScale="5" specularConstant="1.1" specularExponent="26" lighting-color="#e4ecff" result="glint">
                    <fePointLight x="222" y="-24" z="70" />
                    <animate attributeName="specularConstant" values="0.85;1.3;0.85" dur="4s" repeatCount="indefinite" />
                  </feSpecularLighting>
                  <!-- a broad, low sheen from the upper left -->
                  <feSpecularLighting in="bump" surfaceScale="4" specularConstant="0.45" specularExponent="10" lighting-color="#ffffff" result="sheen">
                    <feDistantLight azimuth="235" elevation="38" />
                  </feSpecularLighting>
                  <feMerge result="light"><feMergeNode in="glint" /><feMergeNode in="sheen" /></feMerge>
                  <feComposite in="light" in2="SourceAlpha" operator="in" result="lit" />
                  <!-- a hairline rim on every edge -->
                  <feMorphology in="SourceAlpha" operator="erode" radius="0.45" result="inner" />
                  <feComposite in="SourceAlpha" in2="inner" operator="out" result="edge" />
                  <feFlood flood-color="#ffffff" flood-opacity="0.45" />
                  <feComposite in2="edge" operator="in" result="rim" />
                  <feMerge><feMergeNode in="lit" /><feMergeNode in="rim" /></feMerge>
                </filter>
              </defs>
              <g fill="#fff" filter="url(#hs-glass)" set:html={paths} />
            </svg>
          </div>
        )}
        <div class="hero-frame is-playing">
          <video class="hero-video" autoplay muted loop playsinline aria-hidden="true" data-hs-video>
            <source src="/renders/hero-hold-loop.webm" type="video/webm" />
            <source src="/renders/hero-hold-loop.mp4" type='video/mp4; codecs="hvc1"' />
          </video>
        </div>
        <div class="hero-title">
          {behind(v.id)
            ? <h1 class="visually-hidden">Sublustris Versio</h1>
            : <h1 class="display">Sublustris Versio</h1>}
          <div class="hs-lede">
            <p class="hero-tagline" data-lede>{now}</p>
            <p class="hs-platform" data-platform hidden>{platform}</p>
          </div>
          <div class="actions">
            <Button href="#" variant="ghost">Listen</Button>
            <Button href="#" variant="primary" arrow>Download</Button>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section hs-ledes" aria-labelledby="hs-ledes-h">
    <div class="column flow">
      <h2 id="hs-ledes-h" class="h2">Six ledes</h2>
      <p class="quiet">From the most poetic (1) to an even balance of evocative and informative (6). 1–5 move “for the Noise Engineering Versio, and as an AU/VST3 plugin” to a quieter line under them. The buttons at the bottom of the screen swap them into every version above.</p>
      <ol class="hs-lede-list">{ledes.map((l) => <li>{l}</li>)}</ol>
    </div>
  </section>

  <nav class="hs-switch" aria-label="Lede">
    <span class="mono">Lede</span>
    <button type="button" data-pick="now" aria-pressed="true">Now</button>
    {ledes.map((_, i) => <button type="button" data-pick={i} aria-pressed="false">{i + 1}</button>)}
  </nav>
</Base>

<script define:vars={{ ledes, now }}>
  // Swap the lede in every version; 1-5 show the platform line under it.
  const buttons = document.querySelectorAll('[data-pick]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.pick;
    const text = k === 'now' ? now : ledes[+k];
    document.querySelectorAll('[data-lede]').forEach((p) => { p.textContent = text; });
    document.querySelectorAll('[data-platform]').forEach((p) => { p.hidden = k === 'now' || +k === ledes.length - 1; });
    buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
  }));
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('.hs-glass-light animate').forEach((a) => a.remove());
</script>

<script>
  // Safari plays WebM without its alpha: give it the HEVC film (as HeroMedia does).
  const ua = navigator.userAgent;
  if (/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua)) {
    document.querySelectorAll<HTMLVideoElement>('[data-hs-video]').forEach((v) => {
      v.querySelectorAll('source[type="video/webm"]').forEach((s) => s.remove());
      v.load();
      v.play().catch(() => {});
    });
  }
</script>

<style is:global>
  .hs { min-height: 100svh; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .hs-tag {
    position: absolute; z-index: 3 !important; right: var(--margin); bottom: 1rem; text-align: right;
    max-width: 34rem; color: var(--on-dark-2); font-family: var(--font-mono);
  }
  .hs-tag strong { color: var(--on-dark); margin-right: 0.5em; }
  .hs .hero-frame .hero-video { opacity: 1; }

  /* The LEDs' breath: one per 4 s loop, as the film's OUT LEDs (render_hero.led_levels). */
  @keyframes hs-breathe { 0%, 100% { opacity: 0.72; } 50% { opacity: 1; } }

  /* The name's meaning, at the top of the hero (D, E), in the panel's mono */
  .hs-kicker { font-size: var(--fs-micro); color: var(--on-dark-2); letter-spacing: 0.02em; }
  .hs-kicker em { color: var(--on-dark); }
  .hs-kicker-top { position: absolute; left: var(--margin); top: calc(var(--header-h) + var(--stack-2)); }
  .hs-platform { margin-top: 0.75rem; font-size: var(--fs-small, 1rem); color: var(--on-dark-2); }

  /* C: the title lit from the right (the module's side): dim at the far left, bright and a
     touch of freeze blue near the module; the lit layer breathes. */
  .hs-c .hero-title h1 {
    background: linear-gradient(90deg, rgb(246 245 242 / 0.28) 0%, rgb(246 245 242 / 0.85) 55%, #ffffff 80%, #bcd2ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: hs-breathe-text 4s ease-in-out infinite;
  }
  @keyframes hs-breathe-text { 0%, 100% { filter: brightness(0.86); } 50% { filter: brightness(1.08); } }
  .hs-c .hero-tagline {
    background: linear-gradient(90deg, rgb(168 164 158 / 0.7), var(--on-dark-2) 70%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* B, D, E: the name behind the module, centred, in the panel's lettering (the logo) */
  .hs-b > .wide, .hs-d > .wide, .hs-e > .wide { display: grid; }
  .hs-b .hero-frame, .hs-d .hero-frame, .hs-e .hero-frame { grid-area: 1 / 1; z-index: 1; max-height: max(18rem, calc(100svh - var(--header-h) - 17rem)); }
  .hs-b .hero-video, .hs-d .hero-video, .hs-e .hero-video { translate: none; }
  .hs-mark {
    grid-area: 1 / 1; align-self: center; z-index: 0; position: relative;
    width: 100%; aspect-ratio: 444 / 40; translate: 0 -12%;
  }
  .hs-mark > span { position: absolute; inset: 0; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .hs-b .hs-mark-base { background: rgb(246 245 242 / 0.9); }
  .hs-b .hs-mark-lit { display: none; }
  /* D: dim base, and a lit layer brightest behind the module, fading to the edges, breathing */
  .hs-d .hs-mark-base { background: rgb(246 245 242 / 0.16); }
  .hs-d .hs-mark-lit {
    background: radial-gradient(ellipse 38% 220% at 50% 50%, #ffffff 0%, #d6e2ff 30%, rgb(160 185 255 / 0.55) 60%, transparent 100%);
    animation: hs-breathe 4s ease-in-out infinite;
  }
  /* E: glass. The body blurs and lifts the haze behind it, tinted brightest at the centre; the
     light layer (an SVG filter) adds the specular glints, the sheen and a hairline rim, and
     fades towards the ends so the focus stays behind the module. */
  .hs-glass-body {
    -webkit-backdrop-filter: blur(14px) brightness(1.7) saturate(1.5); backdrop-filter: blur(14px) brightness(1.7) saturate(1.5);
    background: radial-gradient(ellipse 45% 260% at 50% 50%, rgb(205 220 255 / 0.30), rgb(205 220 255 / 0.08) 55%, rgb(255 255 255 / 0.02) 100%);
  }
  .hs-glass-light {
    position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible;
    -webkit-mask: radial-gradient(ellipse 52% 400% at 50% 50%, #000 30%, rgb(0 0 0 / 0.22) 100%);
    mask: radial-gradient(ellipse 52% 400% at 50% 50%, #000 30%, rgb(0 0 0 / 0.22) 100%);
  }
  .hs-b .hero-title, .hs-d .hero-title, .hs-e .hero-title {
    grid-area: 2 / 1; max-width: none; align-self: start; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1rem 2rem;
    padding-top: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }
  .hs-b .hero-title .actions, .hs-d .hero-title .actions, .hs-e .hero-title .actions { padding-top: 0; grid-column: 2; grid-row: 1 / span 2; align-self: end; justify-self: end; }
  .hs-lede { grid-column: 1; }

  /* The six ledes, listed, and the switcher */
  .hs-lede-list { display: grid; gap: 1.25rem; padding-left: 1.5rem; font-size: 1.25rem; line-height: 1.35; }
  .hs-switch {
    position: fixed; z-index: 20; right: var(--margin); top: calc(var(--header-h) + 0.75rem);
    display: flex; align-items: center; gap: 0.25rem; padding: 0.35rem 0.4rem 0.35rem 0.9rem; border-radius: 999px;
    background: rgb(12 13 20 / 0.82); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); color: #f4f5fa;
  }
  .hs-switch .mono { font-size: var(--fs-micro); margin-right: 0.4rem; color: #a8acbb; }
  .hs-switch button {
    min-width: 2.5rem; height: 2.5rem; padding: 0 0.6rem; border: 0; border-radius: 999px;
    background: transparent; color: inherit; font: 600 0.95rem/1 var(--font-sans); cursor: pointer;
  }
  .hs-switch button[aria-pressed="true"] { background: #f4f5fa; color: #0c0d14; }

  @media (max-width: 47.99rem) {
    .hs-b .hero-title, .hs-d .hero-title, .hs-e .hero-title { grid-template-columns: minmax(0, 1fr); }
    .hs-b .hero-title .actions, .hs-d .hero-title .actions, .hs-e .hero-title .actions { grid-column: 1; grid-row: auto; justify-self: start; }
    .hs-tag { left: var(--margin); text-align: left; }
    .hs-note { display: none; }
    .hs-switch { left: var(--margin); right: auto; }
    .hs-switch button { min-width: 2.2rem; height: 2.2rem; padding: 0 0.45rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hs-c .hero-title h1, .hs-d .hs-mark-lit { animation: none; } }
</style>
