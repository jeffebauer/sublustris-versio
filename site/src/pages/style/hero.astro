---
// Hero study (owner, 30 Oct 2026: "a bit bland"): versions of the home hero, each a full
// screen, for the owner to compare and pick. A is the hero as it is; B sets a huge SUBLUSTRIS
// behind the module (the film is transparent); C lights the title from the module's side, as
// the name says, breathing with the LEDs; D combines B and C (the owner's pick, round 1).
// Round 2: E is D with the name in glass (round 3: a shader bends the contour lines behind it,
// like Apple's Liquid Glass, brightest at the centre); the name's meaning
// sits at the top of D and E; candidate ledes replace the spec tags, switchable in place.
// The film here is the hold loop only (no reveal). Not in the sitemap, noindex.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Contours from '../../components/Contours.astro';
import { MINISITE } from '../../lib/paths';

const logo = await readFile(join(MINISITE, 'assets', 'logo', 'sublustris-logo.svg'), 'utf8');
const logoUrl = `data:image/svg+xml;base64,${Buffer.from(logo).toString('base64')}`;
const mark = `url("${logoUrl}")`;
// The logo's paths, for E's lit glass (the filter needs the shapes inline)
const paths = logo.replace(/^[\s\S]*?<g[^>]*>/, '').replace(/<\/g>[\s\S]*$/, '');
const now = 'A half-lit space that never quite ends. Hold a chord forever, play over it, and let it wear like old tape.';   // lede 2, the owner's pick (30 Oct)
// The ledes leave the platform to a quieter line under them.
const ledes = [
  // 2: your shortlist (round 2)
  'A half-lit space that never quite ends. Hold a chord forever, play over it, and let it wear like old tape.',
  // round 4's H, which round 5 builds on
  'A big, dark reverb for ambient and dub techno. Tails run for minutes, or for good, and stay warm all the way down.',
  // round 5 (owner, 31 Oct): H's start with L's range, a little longer; hit the reverb and its
  // character, the infinite hold, and the range of WEAR (tape to AM radio) and MOTION
  'A big, dark reverb for ambient and dub techno. Tails run for minutes or hold forever, and stay warm all the way down. Turn up the wear and it ages, from saturated tape to a crackly AM radio, with wow and flutter to bend it.',
  'A big, dark reverb for ambient and dub techno. Turn the decay up and a chord holds forever while you play over it. Then let it age, from warm tape saturation to a thin, crackly radio, wavering like a cassette on a tired deck.',
  'A big, dark reverb for ambient and dub techno, from a small room to a tail that doesn’t stop. Hold a chord as long as you like and wear it in as you play, with saturation that starts at tape and goes as far as an old radio, and a transport that wobbles like worn tape.',
  'A big, dark reverb for ambient and dub techno. It goes from a small room to an endless hold and stays warm the whole way. One knob saturates it like tape and can push it all the way to AM radio. Another gives it wow and flutter, or a quick, restless wander.',
  'A big, dark reverb for ambient and dub techno. Its tails stay warm from a short room all the way to infinite, where a chord holds for as long as you leave it. Add wear and it saturates like tape, then breaks up like a distant radio station. Add motion and it wobbles like a cassette on its last legs.',
];
const ledeNames = ['2', 'H', 'P', 'Q', 'R', 'S', 'T'];

const platform = 'For the Noise Engineering Versio, and as an AU/VST3 plugin for macOS.';
const versions = [
  { id: 'a', name: 'A · Now', note: 'The hero as it is.' },
  { id: 'b', name: 'B · The name behind', note: 'SUBLUSTRIS across the hero in the panel’s lettering; the module stands in front of it.' },
  { id: 'c', name: 'C · Half-lit', note: 'The title lit from the module’s side, fading into shadow, breathing with the freeze LEDs.' },
  { id: 'd', name: 'D · Both', note: 'Your pick: B’s name behind, lit like C. The name’s meaning now at the top.' },
  { id: 'e', name: 'E · Glass', note: 'D with the name in glass: the name as glass tubes that bend the contour lines behind them, with coloured fringes, a bright rim and a highlight from above the module, brightest at the centre.' },
];
const behind = (id: string) => id === 'b' || id === 'd' || id === 'e';
const top = (id: string) => id === 'd' || id === 'e';
---
<Base title="Hero study: Sublustris Versio" description="Versions of the home hero to compare, with candidate ledes." noindex bodyClass="home" darkTop>
  {versions.map((v) => (
    <section class={`hero band-dark has-contours hs hs-${v.id}`} style={`--mark: ${mark}`} aria-label={v.name}>
      <Contours strength={1} />
      <p class="hs-tag micro"><strong>{v.name}</strong> <span class="hs-note">{v.note}</span></p>
      {top(v.id) && <p class="hs-kicker hs-kicker-top mono"><em>sublustris</em>, Lat. · dimly lit, faintly glowing</p>}
      <div class="wide">
        {(v.id === 'b' || v.id === 'd') && <div class="hs-mark" aria-hidden="true"><span class="hs-mark-base"></span><span class="hs-mark-lit"></span></div>}
        {v.id === 'e' && (
          <div class="hs-mark hs-glass" aria-hidden="true" data-glass data-logo={logoUrl}>
            <canvas class="hs-glass-gl"></canvas>
            <span class="hs-glass-body"></span>
            <svg class="hs-glass-light" viewBox="0 0 444 40" preserveAspectRatio="xMidYMid meet">
              <defs>
                <filter id="hs-glass" x="-4%" y="-40%" width="108%" height="180%" color-interpolation-filters="sRGB">
                  <!-- the letters' bevel: a soft height map from their shape -->
                  <feGaussianBlur in="SourceAlpha" stdDeviation="1.3" result="bump" />
                  <!-- a point light above the module (the centre): the hot glints -->
                  <feSpecularLighting in="bump" surfaceScale="5" specularConstant="1.1" specularExponent="26" lighting-color="#e4ecff" result="glint">
                    <fePointLight x="222" y="-24" z="70" />
                    <animate attributeName="specularConstant" values="0.85;1.3;0.85" dur="4s" repeatCount="indefinite" />
                  </feSpecularLighting>
                  <!-- a broad, low sheen from the upper left -->
                  <feSpecularLighting in="bump" surfaceScale="4" specularConstant="0.45" specularExponent="10" lighting-color="#ffffff" result="sheen">
                    <feDistantLight azimuth="235" elevation="38" />
                  </feSpecularLighting>
                  <feMerge result="light"><feMergeNode in="glint" /><feMergeNode in="sheen" /></feMerge>
                  <feComposite in="light" in2="SourceAlpha" operator="in" result="lit" />
                  <!-- a hairline rim on every edge -->
                  <feMorphology in="SourceAlpha" operator="erode" radius="0.45" result="inner" />
                  <feComposite in="SourceAlpha" in2="inner" operator="out" result="edge" />
                  <feFlood flood-color="#ffffff" flood-opacity="0.45" />
                  <feComposite in2="edge" operator="in" result="rim" />
                  <feMerge><feMergeNode in="lit" /><feMergeNode in="rim" /></feMerge>
                </filter>
              </defs>
              <g fill="#fff" filter="url(#hs-glass)" set:html={paths} />
            </svg>
          </div>
        )}
        <div class="hero-frame is-playing">
          <video class="hero-video" autoplay muted loop playsinline aria-hidden="true" data-hs-video>
            <source src="/renders/hero-hold-loop.webm" type="video/webm" />
            <source src="/renders/hero-hold-loop.mp4" type='video/mp4; codecs="hvc1"' />
          </video>
        </div>
        <div class="hero-title">
          {behind(v.id)
            ? <h1 class="visually-hidden">Sublustris Versio</h1>
            : <h1 class="display">Sublustris Versio</h1>}
          <div class="hs-lede">
            <p class="hero-tagline" data-lede>{now}</p>
            <p class="hs-platform" data-platform>{platform}</p>
          </div>
          <div class="actions">
            <Button href="#" variant="ghost">Listen</Button>
            <Button href="#" variant="primary" arrow>Download</Button>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section hs-ledes" aria-labelledby="hs-ledes-h">
    <div class="column flow">
      <h2 id="hs-ledes-h" class="h2">Ledes</h2>
      <p class="quiet">2 is your shortlist from round 2. A–G are new, written in its voice: short sentences, plain words, about what it does to your playing rather than a list of features. Each moves “for the Noise Engineering Versio, and as an AU/VST3 plugin” to a quieter line under it. The switcher at the top right swaps them into every version above.</p>
      <ul class="hs-lede-list">{ledes.map((l, i) => <li><strong class="mono">{ledeNames[i]}</strong> {l}</li>)}</ul>
    </div>
  </section>

  <nav class="hs-switch" aria-label="Lede">
    <span class="mono">Lede</span>
    <button type="button" data-pick="now" aria-pressed="true">2</button>
    {ledes.map((_, i) => i > 0 && <button type="button" data-pick={i} aria-pressed="false">{ledeNames[i]}</button>)}
  </nav>
</Base>

<script define:vars={{ ledes, now }}>
  // Swap the lede in every version; 1-5 show the platform line under it.
  const buttons = document.querySelectorAll('[data-pick]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.pick;
    const text = k === 'now' ? now : ledes[+k];
    document.querySelectorAll('[data-lede]').forEach((p) => { p.textContent = text; });
    document.querySelectorAll('[data-platform]').forEach((p) => { p.hidden = false; });
    buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
  }));
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('.hs-glass-light animate').forEach((a) => a.remove());
</script>

<script>
  // E's glass, live: a WebGL layer that draws the wordmark as glass tubes looking through to the
  // contour lines behind them (shaders/glass.frag). It runs only while the lines run live (so it
  // samples them at the same time); otherwise the CSS glass under it stays.
  import CONTOURS from '../../shaders/contours.frag?raw';
  import GLASS from '../../shaders/glass.frag?raw';

  const FRAG = '#define GLASS\n' + CONTOURS + '\n' + GLASS;
  const VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.0,1.0);}';

  // The logo's height map: each pixel's distance to the nearest edge (chamfer), shaped into a
  // round tube profile over the bevel radius. r/b hold the height in 16 bits, g the coverage.
  function heightMap(img: HTMLImageElement, w: number, h: number, bevel: number) {
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    const x = c.getContext('2d')!;
    x.drawImage(img, 0, 0, w, h);
    const a = x.getImageData(0, 0, w, h).data;
    const N = w * h, d = new Float32Array(N), BIG = 1e6, D = Math.SQRT2;
    for (let i = 0; i < N; i++) d[i] = a[i * 4 + 3] > 127 ? BIG : 0;
    for (let y = 0; y < h; y++) for (let i = 0; i < w; i++) {
      const k = y * w + i; if (!d[k]) continue;
      let v = d[k];
      if (i > 0) v = Math.min(v, d[k - 1] + 1);
      if (y > 0) { v = Math.min(v, d[k - w] + 1); if (i > 0) v = Math.min(v, d[k - w - 1] + D); if (i < w - 1) v = Math.min(v, d[k - w + 1] + D); }
      d[k] = v;
    }
    for (let y = h - 1; y >= 0; y--) for (let i = w - 1; i >= 0; i--) {
      const k = y * w + i; if (!d[k]) continue;
      let v = d[k];
      if (i < w - 1) v = Math.min(v, d[k + 1] + 1);
      if (y < h - 1) { v = Math.min(v, d[k + w] + 1); if (i < w - 1) v = Math.min(v, d[k + w + 1] + D); if (i > 0) v = Math.min(v, d[k + w - 1] + D); }
      d[k] = v;
    }
    const out = new Uint8Array(N * 4);
    for (let y = 0; y < h; y++) for (let i = 0; i < w; i++) {
      const src = y * w + i, dst = ((h - 1 - y) * w + i) * 4;   // flipped: GL's rows run upward
      const t = Math.min((d[src] - 0.5) / bevel, 1);
      const hh = t > 0 ? Math.sqrt(1 - (1 - t) * (1 - t)) : 0;
      const q = Math.round(hh * 65535);
      out[dst] = q >> 8; out[dst + 2] = q & 255; out[dst + 1] = a[src * 4 + 3]; out[dst + 3] = 255;
    }
    return out;
  }

  function startGlass(el: HTMLElement) {
    const band = el.closest('section')!;
    const lines = band.querySelector<HTMLElement>('[data-contours]');
    const lineCanvas = lines?.querySelector('canvas');
    const canvas = el.querySelector<HTMLCanvasElement>('canvas.hs-glass-gl')!;
    const gl = canvas.getContext('webgl', { premultipliedAlpha: true, antialias: false });
    if (!lines || !lineCanvas || !gl) return;
    const sh = (t: number, src: string) => { const s = gl.createShader(t)!; gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; } return s; };
    const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const p = gl.createProgram()!;
    gl.attachShader(p, vs); gl.attachShader(p, fs); gl.bindAttribLocation(p, 0, 'a'); gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) return;
    gl.useProgram(p);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(p, n);
    gl.uniform1f(U('u_loopT'), 30); gl.uniform1f(U('u_live'), 1); gl.uniform1f(U('u_amt'), parseFloat(lines.dataset.amt || '1')); gl.uniform1f(U('u_ph'), 0);
    gl.uniform1i(U('u_hmap'), 0);
    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    const img = new Image();
    let ready = false, raf = 0, on = false;
    const fit = () => {
      const r = Math.min(devicePixelRatio || 1, 2) * 0.75;
      const w = Math.max(2, Math.round(el.clientWidth * r)), h = Math.max(2, Math.round(el.clientHeight * r));
      if (canvas.width === w && canvas.height === h && ready) return;
      canvas.width = w; canvas.height = h;
      gl.viewport(0, 0, w, h);
      const bevel = h * 0.04;   // a narrow bevel on a flat face (owner, 30 Oct: less rounded)
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, w, h, 0, gl.RGBA, gl.UNSIGNED_BYTE, heightMap(img, w, h, bevel));
      gl.uniform2f(U('u_gRes'), w, h);
      gl.uniform1f(U('u_px2css'), el.clientWidth / w);
      gl.uniform1f(U('u_bevel'), bevel);
      gl.uniform1f(U('u_refr'), el.clientHeight * 0.09);
      ready = true;
    };
    const draw = () => {
      if (!ready || !lines.classList.contains('is-live')) return;
      const b = band.getBoundingClientRect(), m = el.getBoundingClientRect();
      const cs = lineCanvas.width / lineCanvas.clientWidth;
      gl.uniform2f(U('u_res'), lineCanvas.width, lineCanvas.height);
      gl.uniform1f(U('u_cScale'), cs);
      gl.uniform2f(U('u_c'), m.left + m.width / 2 - b.left, b.bottom - (m.top + m.height / 2));
      gl.uniform1f(U('u_rot'), getComputedStyle(el).rotate === 'none' ? 0 : 1);
      const t = parseFloat(lines.dataset.t || '0');
      gl.uniform1f(U('u_t'), t);
      gl.uniform1f(U('u_breath'), 0.5 + 0.5 * Math.sin((t / 4) * Math.PI * 2));
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      el.classList.add('is-gl');
    };
    let last = 0;
    const tick = (now: number) => { raf = requestAnimationFrame(tick); if (now - last < 31) return; last = now; draw(); };
    img.onload = () => {
      fit();
      new ResizeObserver(() => { fit(); draw(); }).observe(el);
      new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on && !raf) raf = requestAnimationFrame(tick); if (!on) { cancelAnimationFrame(raf); raf = 0; } }).observe(el);
    };
    img.src = el.dataset.logo!;
  }
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLElement>('[data-glass]').forEach(startGlass);
</script>

<script>
  // Safari plays WebM without its alpha: give it the HEVC film (as HeroMedia does).
  const ua = navigator.userAgent;
  if (/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua)) {
    document.querySelectorAll<HTMLVideoElement>('[data-hs-video]').forEach((v) => {
      v.querySelectorAll('source[type="video/webm"]').forEach((s) => s.remove());
      v.load();
      v.play().catch(() => {});
    });
  }
</script>

<style is:global>
  .hs { min-height: 100svh; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .hs-tag {
    position: absolute; z-index: 3 !important; right: var(--margin); bottom: 1rem; text-align: right;
    max-width: 34rem; color: var(--on-dark-2); font-family: var(--font-mono);
  }
  /* .has-contours puts its children in flow (position: relative); these two float over the band */
  .hs.hs > .hs-tag, .hs.hs > .hs-kicker-top { position: absolute; }
  .hs-tag strong { color: var(--on-dark); margin-right: 0.5em; }
  .hs .hero-frame .hero-video { opacity: 1; }

  /* The LEDs' breath: one per 4 s loop, as the film's OUT LEDs (render_hero.led_levels). */
  @keyframes hs-breathe { 0%, 100% { opacity: 0.72; } 50% { opacity: 1; } }

  /* The name's meaning, at the top of the hero (D, E), in the panel's mono */
  .hs-kicker { font-size: var(--fs-micro); color: var(--on-dark-2); letter-spacing: 0.02em; }
  .hs-kicker em { color: var(--on-dark); }
  .hs-kicker-top { position: absolute; left: var(--margin); top: calc(var(--header-h) + var(--stack-2)); }
  .hs-platform { margin-top: 0.75rem; font-size: var(--fs-small, 1rem); color: var(--on-dark-2); }

  /* C: the title lit from the right (the module's side): dim at the far left, bright and a
     touch of freeze blue near the module; the lit layer breathes. */
  .hs-c .hero-title h1 {
    background: linear-gradient(90deg, rgb(246 245 242 / 0.28) 0%, rgb(246 245 242 / 0.85) 55%, #ffffff 80%, #bcd2ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: hs-breathe-text 4s ease-in-out infinite;
  }
  @keyframes hs-breathe-text { 0%, 100% { filter: brightness(0.86); } 50% { filter: brightness(1.08); } }
  .hs-c .hero-tagline {
    background: linear-gradient(90deg, rgb(168 164 158 / 0.7), var(--on-dark-2) 70%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* B, D, E: the name behind the module, centred, in the panel's lettering (the logo) */
  .hs-b > .wide, .hs-d > .wide, .hs-e > .wide { display: grid; }
  .hs-b .hero-frame, .hs-d .hero-frame, .hs-e .hero-frame { grid-area: 1 / 1; z-index: 1; max-height: max(18rem, calc(100svh - var(--header-h) - 17rem)); }
  .hs-b .hero-video, .hs-d .hero-video, .hs-e .hero-video { translate: none; }
  .hs-mark {
    grid-area: 1 / 1; align-self: center; z-index: 0; position: relative;
    width: 100%; aspect-ratio: 444 / 40; translate: 0 -12%;
  }
  .hs-mark > span { position: absolute; inset: 0; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .hs-b .hs-mark-base { background: rgb(246 245 242 / 0.9); }
  .hs-b .hs-mark-lit { display: none; }
  /* D: dim base, and a lit layer brightest behind the module, fading to the edges, breathing */
  .hs-d .hs-mark-base { background: rgb(246 245 242 / 0.16); }
  .hs-d .hs-mark-lit {
    background: radial-gradient(ellipse 38% 220% at 50% 50%, #ffffff 0%, #d6e2ff 30%, rgb(160 185 255 / 0.55) 60%, transparent 100%);
    animation: hs-breathe 4s ease-in-out infinite;
  }
  /* E: glass, the fallback (no WebGL, reduced motion). The body blurs and lifts the lines behind it, tinted brightest at the centre; the
     light layer (an SVG filter) adds the specular glints, the sheen and a hairline rim, and
     fades towards the ends so the focus stays behind the module. */
  .hs-glass-body {
    -webkit-backdrop-filter: blur(14px) brightness(1.7) saturate(1.5); backdrop-filter: blur(14px) brightness(1.7) saturate(1.5);
    background: radial-gradient(ellipse 45% 260% at 50% 50%, rgb(205 220 255 / 0.30), rgb(205 220 255 / 0.08) 55%, rgb(255 255 255 / 0.02) 100%);
  }
  .hs-glass-gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s ease; }
  .hs-glass.is-gl .hs-glass-gl { opacity: 1; }
  .hs-glass.is-gl .hs-glass-body, .hs-glass.is-gl .hs-glass-light { opacity: 0; transition: opacity 1.2s ease; }
  .hs-glass-light {
    position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible;
    -webkit-mask: radial-gradient(ellipse 52% 400% at 50% 50%, #000 30%, rgb(0 0 0 / 0.22) 100%);
    mask: radial-gradient(ellipse 52% 400% at 50% 50%, #000 30%, rgb(0 0 0 / 0.22) 100%);
  }
  .hs-b .hero-title, .hs-d .hero-title, .hs-e .hero-title {
    grid-area: 2 / 1; max-width: none; align-self: start; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1rem 2rem;
    padding-top: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }
  .hs-b .hero-title .actions, .hs-d .hero-title .actions, .hs-e .hero-title .actions { padding-top: 0; grid-column: 2; grid-row: 1 / span 2; align-self: end; justify-self: end; }
  .hs-lede { grid-column: 1; }

  /* The ledes, listed, and the switcher */
  .hs-lede-list { display: grid; gap: 1.25rem; padding-left: 0; list-style: none; font-size: 1.25rem; line-height: 1.35; }
  .hs-switch {
    position: fixed; z-index: 20; right: var(--margin); top: calc(var(--header-h) + 0.75rem);
    display: flex; align-items: center; gap: 0.25rem; padding: 0.35rem 0.4rem 0.35rem 0.9rem; border-radius: 999px;
    background: rgb(12 13 20 / 0.82); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); color: #f4f5fa;
  }
  .hs-switch .mono { font-size: var(--fs-micro); margin-right: 0.4rem; color: #a8acbb; }
  .hs-switch button {
    min-width: 2.5rem; height: 2.5rem; padding: 0 0.6rem; border: 0; border-radius: 999px;
    background: transparent; color: inherit; font: 600 0.95rem/1 var(--font-sans); cursor: pointer;
  }
  .hs-switch button[aria-pressed="true"] { background: #f4f5fa; color: #0c0d14; }

  @media (orientation: portrait) and (max-width: 63.99rem) {
    .hs-b .hero-frame, .hs-d .hero-frame, .hs-e .hero-frame { max-height: none; }
    /* The module fills the width; the name behind it is hidden, since the bigger module and
