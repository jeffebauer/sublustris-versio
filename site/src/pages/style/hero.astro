---
// Hero study (owner, 30 Oct 2026: "a bit bland"): four versions of the home hero, each a full
// screen, for the owner to compare and pick. A is the hero as it is; B sets a huge SUBLUSTRIS
// behind the module (the film is transparent); C lights the title from the module's side, as
// the name says, breathing with the LEDs; D combines B and C. C and D add the name's meaning
// and a line of real specs. The film here is the hold loop only (no reveal). Not in the
// sitemap, noindex.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Haze from '../../components/Haze.astro';
import { MINISITE } from '../../lib/paths';

const logo = await readFile(join(MINISITE, 'assets', 'logo', 'sublustris-logo.svg'));
const mark = `url("data:image/svg+xml;base64,${logo.toString('base64')}")`;
const tagline = 'A huge, warm, lush reverb for the Noise Engineering Versio. Also as an AU/VST3 plugin for macOS.';
const specs = ['Plate · Hall · Massive', 'Tails to 2 min, then endless', 'Freeze + paint', 'Versio firmware · AU/VST3'];
const versions = [
  { id: 'a', name: 'A · Now', note: 'The hero as it is.' },
  { id: 'b', name: 'B · The name behind', note: 'SUBLUSTRIS across the hero in the panel’s lettering; the module stands in front of it.' },
  { id: 'c', name: 'C · Half-lit', note: 'The title lit from the module’s side, fading into shadow, breathing with the freeze LEDs. The name’s meaning above, real specs below.' },
  { id: 'd', name: 'D · Both', note: 'B’s name behind, lit like C: bright where the module glows, dim at the edges.' },
];
---
<Base title="Hero study: Sublustris Versio" description="Four versions of the home hero to compare." noindex bodyClass="home" darkTop>
  {versions.map((v) => (
    <section class={`hero band-dark has-haze hs hs-${v.id}`} style={`--mark: ${mark}`} aria-label={v.name}>
      <Haze strength={0.96} />
      <p class="hs-tag micro"><strong>{v.name}</strong> {v.note}</p>
      <div class="wide">
        {(v.id === 'b' || v.id === 'd') && <div class="hs-mark" aria-hidden="true"><span class="hs-mark-base"></span><span class="hs-mark-lit"></span></div>}
        <div class="hero-frame is-playing">
          <video class="hero-video" autoplay muted loop playsinline aria-hidden="true" data-hs-video>
            <source src="/renders/hero-hold-loop.webm" type="video/webm" />
            <source src="/renders/hero-hold-loop.mp4" type='video/mp4; codecs="hvc1"' />
          </video>
        </div>
        <div class="hero-title">
          {(v.id === 'c' || v.id === 'd') && <p class="hs-kicker mono"><em>sublustris</em>, Lat. · dimly lit, faintly glowing</p>}
          {v.id === 'b' || v.id === 'd'
            ? <h1 class="visually-hidden">Sublustris Versio</h1>
            : <h1 class="display">Sublustris Versio</h1>}
          <p class="hero-tagline">{tagline}</p>
          <div class="actions">
            <Button href="#" variant="ghost">Listen</Button>
            <Button href="#" variant="primary" arrow>Download</Button>
          </div>
          {(v.id === 'c' || v.id === 'd') && <ul class="hs-specs mono">{specs.map((s) => <li>{s}</li>)}</ul>}
        </div>
      </div>
    </section>
  ))}
</Base>

<script>
  // Safari plays WebM without its alpha: give it the HEVC film (as HeroMedia does).
  const ua = navigator.userAgent;
  if (/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua)) {
    document.querySelectorAll<HTMLVideoElement>('[data-hs-video]').forEach((v) => {
      v.querySelectorAll('source[type="video/webm"]').forEach((s) => s.remove());
      v.load();
      v.play().catch(() => {});
    });
  }
</script>

<style is:global>
  .hs { min-height: 100svh; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .hs-tag {
    position: absolute; z-index: 3 !important; left: var(--margin); top: calc(var(--header-h) + 0.5rem);
    max-width: 40rem; color: var(--on-dark-2); font-family: var(--font-mono);
  }
  .hs-tag strong { color: var(--on-dark); margin-right: 0.5em; }
  .hs .hero-frame .hero-video { opacity: 1; }

  /* The LEDs' breath: one per 4 s loop, as the film's OUT LEDs (render_hero.led_levels). */
  @keyframes hs-breathe { 0%, 100% { opacity: 0.72; } 50% { opacity: 1; } }

  /* C and D: the name's meaning above, real specs below, in the panel's mono */
  .hs-kicker { font-size: var(--fs-micro); color: var(--on-dark-2); letter-spacing: 0.02em; margin-bottom: 0.75rem; }
  .hs-kicker em { color: var(--on-dark); }
  .hs-specs {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; list-style: none; padding: 0; margin-top: 1.5rem;
    font-size: var(--fs-micro); color: var(--on-dark-2); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .hs-specs { column-gap: 2rem; }

  /* C: the title lit from the right (the module's side): dim at the far left, bright and a
     touch of freeze blue near the module; the lit layer breathes. */
  .hs-c .hero-title h1 {
    background: linear-gradient(90deg, rgb(246 245 242 / 0.28) 0%, rgb(246 245 242 / 0.85) 55%, #ffffff 80%, #bcd2ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: hs-breathe-text 4s ease-in-out infinite;
  }
  @keyframes hs-breathe-text { 0%, 100% { filter: brightness(0.86); } 50% { filter: brightness(1.08); } }
  .hs-c .hero-tagline {
    background: linear-gradient(90deg, rgb(168 164 158 / 0.7), var(--on-dark-2) 70%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* B and D: the name behind the module, centred, in the panel's lettering (the logo) */
  .hs-b > .wide, .hs-d > .wide { display: grid; }
  .hs-b .hero-frame, .hs-d .hero-frame { grid-area: 1 / 1; z-index: 1; max-height: max(18rem, calc(100svh - var(--header-h) - 17rem)); }
  .hs-b .hero-still, .hs-b .hero-video, .hs-d .hero-still, .hs-d .hero-video { translate: none; }
  .hs-mark {
    grid-area: 1 / 1; align-self: center; z-index: 0; position: relative;
    width: 100%; aspect-ratio: 444 / 40; translate: 0 -12%;
  }
  .hs-mark > span { position: absolute; inset: 0; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .hs-b .hs-mark-base { background: rgb(246 245 242 / 0.9); }
  .hs-b .hs-mark-lit { display: none; }
  /* D: dim base, and a lit layer brightest behind the module, fading to the edges, breathing */
  .hs-d .hs-mark-base { background: rgb(246 245 242 / 0.16); }
  .hs-d .hs-mark-lit {
    background: radial-gradient(ellipse 38% 220% at 50% 50%, #ffffff 0%, #d6e2ff 30%, rgb(160 185 255 / 0.55) 60%, transparent 100%);
    animation: hs-breathe 4s ease-in-out infinite;
  }
  .hs-b .hero-title, .hs-d .hero-title {
    grid-area: 2 / 1; max-width: none; align-self: start; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1rem 2rem;
    padding-top: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }
  .hs-b .hero-title .actions, .hs-d .hero-title .actions { padding-top: 0; grid-column: 2; grid-row: 1 / span 2; align-self: end; justify-self: end; }
  .hs-d .hs-kicker { grid-column: 1; margin-bottom: 0; }
  .hs-d .hero-tagline { grid-column: 1; }
  .hs-d .hs-specs { grid-column: 1 / -1; margin-top: 0.5rem; }
  @media (max-width: 47.99rem) {
    .hs-b .hero-title, .hs-d .hero-title { grid-template-columns: minmax(0, 1fr); }
    .hs-b .hero-title .actions, .hs-d .hero-title .actions { grid-column: 1; grid-row: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .hs-c .hero-title h1, .hs-d .hs-mark-lit { animation: none; } }
</style>
