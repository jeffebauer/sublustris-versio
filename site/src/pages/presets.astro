---
import Doc from '../layouts/Doc.astro';
import PanelArt from '../components/PanelArt.astro';
import KnobGlyph from '../components/KnobGlyph.astro';
import { getPage, pageHtml, splitSections, stripTags, takeH1 } from '../lib/content';
import { KNOBS, SWITCHES, type PanelSettings } from '../lib/panel';

const page = await getPage('presets');
const { h1, rest } = takeH1(pageHtml(page));

// The settings table in the copy is the one source of the numbers. The page reads it and
// draws each row as a set panel beside its starting point, instead of showing the table.
const table = rest.match(/<div class="table-scroll"[^>]*>\s*<table[\s\S]*?<\/table>\s*<\/div>/)?.[0] ?? '';
const cells = (row: string) => [...row.matchAll(/<t[hd][^>]*>([\s\S]*?)<\/t[hd]>/g)].map((m) => stripTags(m[1]));
const [head, ...rows] = [...table.matchAll(/<tr>([\s\S]*?)<\/tr>/g)].map((m) => cells(m[1]));
if (!head || !rows.length) throw new Error('presets.md: the settings table is missing');
const col = (name: string) => {
  const i = head.findIndex((h) => h.toUpperCase() === name);
  if (i < 0) throw new Error(`presets.md: no ${name} column`);
  return i;
};
// Each knob cell reads "0.8 (3)": the value, and its clock position.
const settings = new Map<string, { s: PanelSettings; shown: Record<string, string>; clock: Record<string, string> }>();
for (const r of rows) {
  const s: Record<string, number | string> = {};
  const shown: Record<string, string> = {};
  const clock: Record<string, string> = {};
  for (const w of SWITCHES) s[w.key] = shown[w.name] = r[col(w.name)];
  for (const k of KNOBS) {
    const cell = r[col(k.name)];
    s[k.key] = parseFloat(cell);
    // the value and the clock position get columns of their own, so they line up row to row (owner, 1 Nov 2026)
    shown[k.name] = cell.replace(/\s*\(.*$/, '');
    const m = cell.match(/\((\d+)(:\d+)?\)/);
    clock[k.name] = m ? `${m[1]}${m[2] ?? ':00'}` : '';
  }
  settings.set(r[0], { s: s as PanelSettings, shown, clock });
}

const { lead, sections } = splitSections(rest.replace(table, ''));
---
<Doc page={page} h1={h1} kicker="Sublustris Versio · ambient, dub techno and dark ambient settings">
  <Fragment set:html={lead} />
  {sections.map((sec) => {
    const p = settings.get(sec.title);
    if (!p) return <Fragment set:html={`<h2 id="${sec.id}">${sec.title}</h2>${sec.html}`} />;
    return (
      <>
        <h2 id={sec.id}>{sec.title}</h2>
        <div class="preset">
          <figure class="preset-panel">
            <PanelArt settings={p.s} controls prefix={`pre-${sec.id}`} label={`${sec.title}: panel settings`} />
          </figure>
          <div class="preset-text">
            <Fragment set:html={sec.html} />
            <dl class="preset-values" aria-label={`${sec.title}: exact values`}>
              {SWITCHES.map((w) => <div><dt>{w.name}</dt><dd>{p.shown[w.name]}</dd></div>)}
              {KNOBS.map((k) => <div><dt>{k.name}</dt><dd><span class="knob-value"><KnobGlyph value={p.s[k.key]} /><span class="kv-num">{p.shown[k.name]}</span><span class="kv-clock">{p.clock[k.name]}</span></span></dd></div>)}
              {(SWITCHES.length + KNOBS.length) % 2 === 1 && <div class="filler" aria-hidden="true" />}
            </dl>
          </div>
        </div>
      </>
    );
  })}
</Doc>

<style>
  /* Same gap between drawing and text as the manual's panel map (Resilio, owner 7 Oct). */
  .preset { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: var(--stack-3) 3.5rem; align-items: start; margin-block: var(--stack-4) var(--stack-4); }
  .preset-panel { margin: 0; }
  .preset-text > :global(:first-child) { margin-top: 0; }
  .preset-text > :global(* + *) { margin-top: var(--stack-2); }
  .preset-text > .preset-values { margin-top: var(--stack-3); }
  /* The exact values: a small two-across definition list under the text, hairlines running
     unbroken across both pairs. */
  /* One pair per row, two across only where both fit (the text column, not the screen, decides). */
  .preset-text { container-type: inline-size; }
  .preset-values {
    display: grid; grid-template-columns: minmax(0, 1fr); margin: 0;
    font: var(--wt-reg) var(--fs-small) / 1.3 var(--font-sans); border-bottom: var(--hair) solid var(--line);
  }
  .preset-values div { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr); align-items: center; padding: 0.45rem 0; border-top: var(--hair) solid var(--line); }
  .preset-values .filler { display: none; }   /* only fills the last row when two across */
  @container (min-width: 34rem) {
    .preset-values { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .preset-values .filler { display: grid; }
    .preset-values div:nth-child(odd) { padding-right: var(--gutter); }
  }
  .preset-values dt { color: var(--ink-2); font: var(--wt-reg) var(--fs-micro) / 1.3 var(--font-mono); text-transform: uppercase; }
  .preset-values dd { margin: 0; color: var(--ink); font-variant-numeric: tabular-nums; }
  @media (max-width: 39.99rem) {
    .preset { grid-template-columns: minmax(0, 1fr); }
    .preset-panel { max-width: 15rem; }
  }
</style>
