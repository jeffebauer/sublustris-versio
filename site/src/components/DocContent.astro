---
// Renders a page's Markdown with its slot markers swapped for components.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PanelArt from './PanelArt.astro';
import DownloadBlock from './DownloadBlock.astro';
import MediaCard from './MediaCard.astro';
import type { Part } from '../lib/content';
import { PUBLIC_DIR } from '../lib/paths';

interface Props { parts: Part[] }
const { parts: given } = Astro.props;
// The plugin screenshot, once docs/minisite/assets/screenshots/plugin-panel.png exists.
const shot = existsSync(join(PUBLIC_DIR, 'screenshots', 'plugin-panel.png'));
// The panel map's table sits beside the drawing on wide screens (owner, 7 Oct): when the
// panel slot is followed straight away by a table, it moves into the slot.
const TABLE = /^\s*(<div class="table-scroll"[^>]*>\s*<table[\s\S]*?<\/table>\s*<\/div>)/;
const parts = given.map((p) => ({ ...p })) as (Part & { table?: string })[];
parts.forEach((p, i) => {
  const next = parts[i + 1];
  if (p.kind === 'slot' && p.slot === 'panel' && next?.kind === 'html') {
    const m = next.html.match(TABLE);
    if (m) { p.table = m[1]; next.html = next.html.slice(m[0].length); }
  }
});
---
{parts.map((p) =>
  p.kind === 'html' ? (
    <Fragment set:html={p.html} />
  ) : p.slot === 'panel' ? (
    <div class="slot manual-panel">
      <figure class="panel-figure">
        <PanelArt prefix="manual-panel" />
        <figcaption class="small panel-note">Sublustris’s panel, to scale. Your Versio’s printed labels will differ: the table maps them.</figcaption>
      </figure>
      {p.table && <div class="panel-table" set:html={p.table} />}
    </div>
  ) : p.slot === 'screenshot' ? (
    <div class="slot manual-screenshot">
      <MediaCard
        caption="The plugin: the same panel layout as the module"
        src={shot ? '/screenshots/plugin-panel.png' : undefined}
        alt="The Sublustris Versio plugin window: seven knobs (BLEND, DECAY, TONE, WEAR, SIZE, MOTION, DEPTH), the SPACE and ONSET switches, the FREEZE / PAINT button, input and output meters, and the ZOOM setting."
        ratio="253:643"
        render={{ id: 'plugin-panel.png', name: 'Plugin screenshot' }}
      />
    </div>
  ) : p.slot === 'downloads' || p.slot === 'latest' ? (
    <div class="slot"><DownloadBlock compact headingLevel="h2" idPrefix={`dl-${p.slot}`} /></div>
  ) : null
)}
