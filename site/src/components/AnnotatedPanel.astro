---
// The annotated panel (DESIGN-v2 V7): a callout box per control, joined to it by a thin leader
// line, on Resilio's 2116 × 1190 stage. Until the front-on render exists, the panel map
// (docs/minisite/assets/panel/sublustris-versio-panel.svg, themed by the --sv-* tokens) stands
// where the render's panel will be; dropping front-on-wide.jpg into docs/minisite/assets/renders/
// puts the render in its place, with the same geometry. One ordered list either way.
import { Picture } from 'astro:assets';
import PanelDiagram from './PanelDiagram.astro';
import { render, widthsFor } from '../lib/renders';
import { CONTROLS } from '../data/controls';

interface Props { prefix?: string }
const { prefix = 'pc' } = Astro.props;
const front = render('front-on-wide.jpg');

// The render's frame and where the 50.5 × 128.5 mm panel sits in it (Resilio's measurements).
const IMG = { w: 2116, h: 1190 };
const PANEL = { x: 872, y: 121, w: 372, h: 950 };
const MM = { w: 50.5, h: 128.5 };
const CROP = { x: 800, y: 80, w: 516, h: 1032 };

const px = (mm: number) => PANEL.x + (mm / MM.w) * PANEL.w;
const py = (mm: number) => PANEL.y + (mm / MM.h) * PANEL.h;
const pct = (v: number, of: number) => +((v / of) * 100).toFixed(3);

const BOX_EDGE = { l: 0.37 * IMG.w, r: 0.63 * IMG.w };
const columns = { l: { top: 0.1, step: 0.13 }, r: { top: 0.1, step: 0.13 } };
const order = { l: 0, r: 0 };
const items = [...CONTROLS]
  .map((c, i) => ({ ...c, n: i + 1 }))
  .sort((a, b) => (a.slot ?? a.at[1]) - (b.slot ?? b.at[1]))
  .map((c) => {
    const col = columns[c.side];
    const by = (col.top + col.step * order[c.side]++) * IMG.h;
    const x = px(c.at[0]);
    const y = py(c.at[1]);
    return {
      ...c, x, y, bx: BOX_EDGE[c.side], by,
      style: [
        `--cx:${pct(x - CROP.x, CROP.w)}%`, `--cy:${pct(y - CROP.y, CROP.h)}%`,
        `--bx:${pct(BOX_EDGE[c.side], IMG.w)}%`, `--by:${pct(by, IMG.h)}%`,
      ].join(';'),
    };
  })
  .sort((a, b) => a.n - b.n);

const stage = [
  `--img-w:${pct(IMG.w, CROP.w)}%`, `--img-x:${pct(-CROP.x, CROP.w)}%`, `--img-y:${pct(-CROP.y, CROP.h)}%`,
  `--crop-ratio:${CROP.w} / ${CROP.h}`, `--full-ratio:${IMG.w} / ${IMG.h}`,
].join(';');
const panelBox = `left:${pct(PANEL.x, IMG.w)}%;top:${pct(PANEL.y, IMG.h)}%;width:${pct(PANEL.w, IMG.w)}%;height:${pct(PANEL.h, IMG.h)}%`;
---
<figure class:list={['ap', !front && 'ap-map']} style={stage}>
  <div class="ap-stage">
    <div class="ap-crop">
      {front && <Picture src={front} widths={widthsFor(front)} sizes="(min-width: 80rem) 92rem, 1200px" formats={['avif', 'webp']} loading="lazy"
        alt="The Versio module with the Sublustris panel, seen straight on: seven knobs, the SPACE and ONSET switches, the FREEZE / PAINT button, four LEDs and twelve jacks." />}
      <div class="ap-canvas">
        {!front && <div class="ap-panel" style={panelBox}><PanelDiagram prefix={prefix} class="is-themed" /></div>}
        <svg class="ap-lines" viewBox={`0 0 ${IMG.w} ${IMG.h}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {items.map((c) => (
            <g data-n={c.n}>
              <path d={`M${c.bx.toFixed(1)} ${c.by.toFixed(1)}H${(c.bx + (c.side === 'l' ? 24 : -24)).toFixed(1)}L${c.x.toFixed(1)} ${c.y.toFixed(1)}`} />
              <circle cx={c.x.toFixed(1)} cy={c.y.toFixed(1)} r="7" />
            </g>
          ))}
        </svg>
      </div>
      {items.map((c) => <span class="ap-marker" style={c.style} aria-hidden="true">{c.n}</span>)}
    </div>
  </div>
  <ol class="ap-list" aria-label="Sublustris’s controls on the panel">
    {items.map((c) => (
      <li class={`ap-callout side-${c.side}`} style={c.style}>
        <span class="ap-num" aria-hidden="true">{c.n}</span>
        <span class="ap-text">
          <a class="ap-name" href={`/manual/#${c.anchor}`}>{c.name}</a>
          <span class="ap-line">{c.line}</span>
        </span>
      </li>
    ))}
  </ol>
  <figcaption class="micro quiet">{front ? 'The Noise Engineering Versio with Sublustris’s panel.' : 'The Noise Engineering Versio with Sublustris’s controls, drawn to scale.'}</figcaption>
</figure>

<style is:global>
  /* The map version of the annotated panel: the canvas is the render's frame, the panel map
     stands where the render's panel is, and the stage's well is --ap-ground. */
  .ap-map .ap-stage { background: var(--ap-ground, var(--tile)); }
  .ap-map .ap-canvas { position: absolute; inset: 0; }
  .ap-map .ap-panel { position: absolute; }
  .ap-map .ap-panel .panel-diagram, .ap-map .ap-panel svg { width: 100%; height: 100%; }
  .ap-map .ap-lines path { filter: none; stroke: var(--ink); }
  .ap-map .ap-lines circle { stroke: var(--ap-ground, var(--tile)); }
  .ap-map .ap-marker { box-shadow: 0 0 0 1.5px var(--ap-ground, var(--tile)); }
  .ap-map .panel-diagram .knobmark { stroke: var(--sv-ink-soft); }
  @media (min-width: 80rem) {
    .ap-map .ap-name { color: var(--ink); }
    .ap-map .ap-line { color: var(--ink-2); }
  }
  @media (max-width: 79.99rem) {
    .ap-map .ap-canvas { inset: auto; left: var(--img-x); top: var(--img-y); width: var(--img-w); aspect-ratio: var(--full-ratio); }
  }
</style>
