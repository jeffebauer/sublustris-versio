---
// The hero frame (DESIGN-v2, Home 1). Until the panel art and its renders exist, a labelled
// placeholder at the still's 16:9 (docs/minisite/README.md, "Renders to come"). Dropping
// hero-still.jpg into docs/minisite/assets/renders/ shows the still; adding hero-loop.mp4 and/or
// hero-loop.webm plays that film over it, muted and looping, with a pause button. The still is
// what shows without JavaScript, when autoplay is blocked, and to everyone under reduced motion.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { PUBLIC_DIR } from '../lib/paths';
import { render, widthsFor } from '../lib/renders';

const still = render('hero-still.jpg');
const sizes = '(min-width: 92rem) 92rem, calc(100vw - 2rem)';
const film = (['webm', 'mp4'] as const)
  .filter((ext) => existsSync(join(PUBLIC_DIR, 'renders', `hero-loop.${ext}`)))
  .map((ext) => ({ src: `/renders/hero-loop.${ext}`, type: `video/${ext}` }));
const alt = 'The Sublustris Versio module in half-light, its output LEDs glowing blue.';
---
{still ? (
  <div class="hero-frame" data-hero>
    <Picture class="hero-still" src={still} widths={widthsFor(still)} sizes={sizes} formats={['avif', 'webp']} fetchpriority="high" loading="eager" alt={alt} />
    {film.length > 0 && (
      <>
        <video class="hero-video hero-hold" muted playsinline loop preload="none" aria-hidden="true" data-hero-video>
          {film.map((s) => <source src={s.src} type={s.type} />)}
        </video>
        <button class="hero-pause" type="button" data-hero-pause hidden>
          <span class="visually-hidden">Pause the film</span>
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor" /></svg>
        </button>
      </>
    )}
  </div>
) : (
  <Placeholder id="hero-still.jpg" name="Hero still (the film’s poster)" ratio="16:9" class="hero-placeholder" />
)}
{still && film.length > 0 && (
  <script>
    // Play the loop once it can; nothing plays under reduced motion, and the still stays.
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const pause = document.querySelector<HTMLButtonElement>('[data-hero-pause]');
    if (video && pause && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.preload = 'auto';
      video.addEventListener('playing', () => { video.classList.add('is-on'); pause.hidden = false; }, { once: true });
      video.play().catch(() => {});
      pause.addEventListener('click', () => {
        const paused = !video.paused;
        if (paused) video.pause(); else video.play().catch(() => {});
        pause.classList.toggle('is-paused', paused);
        pause.querySelector('.visually-hidden')!.textContent = paused ? 'Play the film' : 'Pause the film';
      });
    }
  </script>
)}
