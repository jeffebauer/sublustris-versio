---
import { DOCS, DOWNLOADS_LIVE, LINKS } from '../data/site';
// GitHub links work only once the repository is public (BRIEF §8): until then they're plain text.
const gh = (href: string, label: string) => ({ href: DOWNLOADS_LIVE ? href : undefined, label });
const project = [gh(LINKS.source, 'Source on GitHub'), { href: LINKS.feedbackFaq, label: 'Feedback' }, { href: '/#download', label: 'Download' }, { href: 'https://resilio-versio.vercel.app', label: 'Resilio Versio, its sibling' }];
const licence = [gh(LINKS.mit, 'Code, tools, docs: MIT'), gh(LINKS.agpl, 'Plugin: AGPLv3'), gh(LINKS.notice, 'Third-party notices')];
---
<footer class="site-footer">
  <div class="wide">
    <div>
      <p class="brand">Sublustris Versio</p>
      <p class="small quiet">A huge, warm, lush reverb for the Noise Engineering Versio.</p>
      <div class="theme-switch" role="group" aria-label="Colour theme">
        <button type="button" data-theme-pick="system" aria-pressed="true">System</button>
        <button type="button" data-theme-pick="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-pick="dark" aria-pressed="false">Dark</button>
      </div>
    </div>
    <div class="lists">
      <nav aria-labelledby="f-docs">
        <h2 id="f-docs">Docs</h2>
        <ul>{DOCS.map((d) => <li><a href={d.href}>{d.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2 id="f-project">Project</h2>
        <ul aria-labelledby="f-project">
          {project.map((l) => <li>{l.href ? <a href={l.href}>{l.label}</a> : <span class="quiet">{l.label} (when public)</span>}</li>)}
        </ul>
      </div>
      <div>
        <h2 id="f-licence">Licence</h2>
        <ul aria-labelledby="f-licence">
          {licence.map((l) => <li>{l.href ? <a href={l.href}>{l.label}</a> : <span>{l.label}</span>}</li>)}
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>Sublustris Versio is firmware for the Noise Engineering Versio, and an AU/VST3 plugin for macOS. Not affiliated with or endorsed by Noise Engineering. Versio is a trademark of Noise Engineering. VST is a registered trademark of Steinberg Media Technologies GmbH. Audio Units is a trademark of Apple Inc. Cookie-free analytics, no personal data.</p>
      <p class="credit">Made with love for the modular community by <a href={LINKS.author}>Jesse Bauer</a></p>
    </div>
  </div>
</footer>

<script>
  // The theme switch: System (no choice stored) follows the OS; Light or Dark is remembered
  // in this browser only. The head script applies it before first paint.
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-pick]')];
  const show = (pick: string) => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themePick === pick)));
  show(root.dataset.theme ?? 'system');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const pick = b.dataset.themePick ?? 'system';
    if (pick === 'system') delete root.dataset.theme; else root.dataset.theme = pick;
    try { if (pick === 'system') localStorage.removeItem('sv-theme'); else localStorage.setItem('sv-theme', pick); } catch {}
    show(pick);
  }));
</script>
